{
    "permissions": {
        "deny": [
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./.env.production)",
            "Read(./.env.staging)",
            "Read(./.env.backup)"
        ]
    },
    "extraKnownMarketplaces": {
        "tall-flow": {
            "source": {
                "source": "github",
                "repo": "josephdlmd/tall-flow"
            },
            "autoUpdate": true
        },
        "mattpocock": {
            "source": {
                "source": "github",
                "repo": "mattpocock/skills"
            },
            "autoUpdate": true
        }
    },
    "enabledPlugins": {
        "tall-flow@tall-flow": true,
        "mattpocock-skills@mattpocock": true
    }
}
